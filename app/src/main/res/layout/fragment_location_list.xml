<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/locationListFragment"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_color">

    <!-- Top Bar: Search & Actions -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="4dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="12dp"
            android:gravity="center_vertical">

            <!-- Search Bar Pill -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/lt_gray"
                app:strokeWidth="1dp"
                app:cardBackgroundColor="@color/background_color">

                <androidx.appcompat.widget.SearchView
                    android:id="@+id/searchView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:queryHint="Search by name"
                    app:iconifiedByDefault="false"
                    app:queryBackground="@android:color/transparent"
                    app:submitBackground="@android:color/transparent" />
            </com.google.android.material.card.MaterialCardView>

            <!-- Filter Button -->
            <ImageButton
                android:id="@+id/filterButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/filter_categories_button"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:tint="@color/black"
                app:srcCompat="@drawable/filter" />

            <!-- Analysis Button -->
            <ImageButton
                android:id="@+id/analysisButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/analysis_button"
                android:padding="12dp"
                android:scaleType="fitCenter"
                app:tint="@color/black"
                app:srcCompat="@drawable/analysis" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Empty State -->
    <TextView
        android:id="@+id/noSearchResults"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/no_search_result"
        android:textColor="@color/gray"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="40dp"
        android:textSize="16sp" />

    <!-- Main List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp"
        android:contentDescription="@string/location_list" />

    <!-- Bottom Action Area -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardElevation="8dp"
        app:cardCornerRadius="0dp"
        app:cardBackgroundColor="@color/surface">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <!-- Primary Action: Solid Blue Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/addLocationButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="@string/add_location_button"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/white"
                app:backgroundTint="@color/primary_dark"
                app:cornerRadius="8dp" />

            <!-- Secondary Action: Outlined Black -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/viewVisitedButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="8dp"
                android:text="@string/view_visited_button"
                android:fontFamily="sans-serif-medium"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@color/black"
                app:strokeColor="@color/black"
                app:cornerRadius="8dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>